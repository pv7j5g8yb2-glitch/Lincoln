    { "id": "nothing-sent", "kind": "never", "where": "sent", "what": "Nothing is sent without an attorney's approval", "any": ["."] },
    { "id": "nothing-decided", "kind": "never", "where": "decided", "what": "No approval is decided by Lincoln", "any": ["."] },
